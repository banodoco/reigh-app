+def list_element_descriptors_from_definitions(
+    definitions: Any,
+) -> tuple[dict[str, Any], ...]:
+    """Project already-admitted definitions with the canonical descriptor path."""
+
+    materialized = tuple(definitions)
+    keys = tuple((definition.kind, definition.id) for definition in materialized)
+    if len(set(keys)) != len(keys):
+        raise ValueError("selected element definitions contain duplicate kind/id keys")
+    if any(definition.kind not in EDITOR_CATALOG_KINDS for definition in materialized):
+        raise ValueError("selected element definitions contain a non-editor kind")
+    return tuple(_element_descriptor(definition) for definition in materialized)
+
+
