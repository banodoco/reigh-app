new file mode 100644
index 0000000..66e952c
--- /dev/null
+++ b/astrid/core/element/selected_profile.py
@@ -0,0 +1,168 @@
+"""Server-owned request-local element profile admission."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import stat
+from dataclasses import dataclass
+from pathlib import Path
+from types import MappingProxyType
+from typing import Any, Mapping
+
+from astrid.core.element.catalog import list_element_descriptors_from_definitions
+from astrid.core.element.registry import ElementRegistry, load_selected_pack_elements
+from astrid.core.foundation.paths import REPO_ROOT
+from astrid.core.pack import load_pack_manifest
+
+PUBLIC_PROFILE_ID = "astrid-public-v1"
+PUBLIC_LOCK_PATH = REPO_ROOT / "config" / "astrid-public-source.lock.json"
+PUBLIC_BINDING_PATH = REPO_ROOT.with_name(f"{REPO_ROOT.name}.profile-binding.json")
+
+
+@dataclass(frozen=True)
+class SelectedElementContext:
+    profile_id: str
+    package_sha256: str
+    package_root: Path
+    project_dir: Path
+    registry: ElementRegistry
+    descriptors: tuple[Mapping[str, Any], ...]
+    pack_order: tuple[Mapping[str, str], ...]
+
+    def provenance(self) -> dict[str, Any]:
+        return {
+            "id": self.profile_id,
+            "package_sha256": self.package_sha256,
+            "selected_descriptors": [dict(item) for item in self.descriptors],
+            "pack_order": [dict(item) for item in self.pack_order],
+        }
+
+
+def _require_exact_object(
+    value: Any,
+    *,
+    keys: frozenset[str],
+    label: str,
+) -> Mapping[str, Any]:
+    if not isinstance(value, Mapping):
+        raise TypeError(f"{label} must be an object")
+    if set(value) != keys:
+        raise ValueError(f"{label} must contain exactly: {', '.join(sorted(keys))}")
+    return value
+
+
+def _package_manifest(root: Path) -> tuple[list[dict[str, Any]], str]:
+    entries: list[dict[str, Any]] = []
+    for path in sorted(root.rglob("*"), key=lambda item: item.relative_to(root).as_posix()):
+        relative = path.relative_to(root).as_posix()
+        if relative.startswith("remotion-public/"):
+            continue
+        if "/__pycache__/" in f"/{relative}/" or relative.endswith((".pyc", ".pyo")):
+            continue
+        mode = stat.S_IMODE(path.lstat().st_mode)
+        if path.is_symlink():
+            entries.append({"path": relative, "type": "symlink", "mode": mode, "target": os.readlink(path)})
+        elif path.is_file():
+            data = path.read_bytes()
+            entries.append({
+                "path": relative,
+                "type": "file",
+                "mode": mode,
+                "bytes": len(data),
+                "sha256": hashlib.sha256(data).hexdigest(),
+            })
+    payload = json.dumps(entries, sort_keys=True, separators=(",", ":")).encode("utf-8")
+    return entries, hashlib.sha256(payload).hexdigest()
+
+
+def _load_binding() -> Mapping[str, Any]:
+    payload = json.loads(PUBLIC_BINDING_PATH.read_text(encoding="utf-8"))
+    return _require_exact_object(
+        payload,
+        keys=frozenset({"id", "package_sha256", "worker_project", "manifest_sha256"}),
+        label="server-owned element profile binding",
+    )
+
+
+def load_selected_element_context(profile: Any) -> SelectedElementContext | None:
+    """Validate a public request profile or return ``None`` for no profile."""
+
+    if profile is None:
+        return None
+    request = _require_exact_object(
+        profile,
+        keys=frozenset({"id", "package_sha256"}),
+        label="rendering.remotion.element_profile",
+    )
+    profile_id = request["id"]
+    requested_hash = request["package_sha256"]
+    if profile_id != PUBLIC_PROFILE_ID:
+        raise ValueError(f"unknown element profile id: {profile_id!r}")
+    if not isinstance(requested_hash, str) or len(requested_hash) != 64 or any(ch not in "0123456789abcdef" for ch in requested_hash):
+        raise ValueError("element profile package_sha256 must be a lowercase SHA-256")
+
+    binding = _load_binding()
+    if binding["id"] != PUBLIC_PROFILE_ID or binding["package_sha256"] != requested_hash:
+        raise ValueError("element profile package identity does not match the server-owned binding")
+    _, actual_hash = _package_manifest(REPO_ROOT)
+    if actual_hash != requested_hash or binding["manifest_sha256"] != actual_hash:
+        raise ValueError("element profile package bytes no longer match the qualified identity")
+
+    lock = json.loads(PUBLIC_LOCK_PATH.read_text(encoding="utf-8"))
+    raw_selections = lock.get("selections") if isinstance(lock, dict) else None
+    if not isinstance(raw_selections, list) or len(raw_selections) != 12:
+        raise ValueError("public source lock must contain exactly twelve selections")
+    requested: list[tuple[str, str, str]] = []
+    for item in raw_selections:
+        selection = _require_exact_object(
+            item,
+            keys=frozenset({"pack", "kind", "id"}),
+            label="public source selection",
+        )
+        values = (selection["pack"], selection["kind"], selection["id"])
+        if not all(isinstance(value, str) and value for value in values):
+            raise ValueError("public source selection values must be non-empty strings")
+        requested.append(values)
+    if len(set(requested)) != 12:
+        raise ValueError("public source lock selections must be unique")
+
+    registry = ElementRegistry()
+    pack_order: list[Mapping[str, str]] = []
+    for pack_id in dict.fromkeys(pack for pack, _, _ in requested):
+        pack = load_pack_manifest(
+            REPO_ROOT / "astrid" / "packs" / pack_id / "pack.yaml",
+            expected_pack_id=pack_id,
+        )
+        definitions = load_selected_pack_elements(
+            pack,
+            tuple((kind, element_id) for selected_pack, kind, element_id in requested if selected_pack == pack_id),
+        )
+        for definition in definitions:
+            registry.register(definition)
+        pack_order.append(MappingProxyType({"id": pack.id, "version": pack.version}))
+
+    definitions = tuple(registry.get(kind, element_id) for _, kind, element_id in requested)
+    actual = tuple((str(item.metadata.get("pack_id")), item.kind, item.id) for item in definitions)
+    expected = tuple(
+        (pack_id, registry.element_kind_registry.normalize(kind), element_id)
+        for pack_id, kind, element_id in requested
+    )
+    if actual != expected:
+        raise ValueError(f"public element profile resolved unexpected definitions: {actual!r}")
+    descriptors = tuple(MappingProxyType(item) for item in list_element_descriptors_from_definitions(definitions))
+
+    worker_project = Path(str(binding["worker_project"])).resolve()
+    expected_project = REPO_ROOT / "remotion-public"
+    if worker_project != expected_project:
+        raise ValueError("server-owned element profile worker project is not the qualified sibling")
+    return SelectedElementContext(
+        profile_id=PUBLIC_PROFILE_ID,
+        package_sha256=requested_hash,
+        package_root=REPO_ROOT,
+        project_dir=worker_project,
+        registry=registry,
+        descriptors=descriptors,
+        pack_order=tuple(pack_order),
+    )
