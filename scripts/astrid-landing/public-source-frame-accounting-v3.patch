index 1a326b9..09d149f 100644
--- a/astrid/core/element/registry.py
+++ b/astrid/core/element/registry.py
@@ -248,6 +248,66 @@ def load_pack_elements(
     )
 
 
+def load_selected_pack_elements(
+    pack: PackDefinition,
+    selections: Iterable[tuple[str, str]],
+    *,
+    element_kind_registry: ElementKindRegistry | None = None,
+) -> tuple[ElementDefinition, ...]:
+    """Strictly load an exact ordered selection from one canonical pack.
+
+    Unlike default discovery, this projection is fail-closed: duplicate or
+    missing selections and every definition or pack-alignment error propagate
+    to the caller. No partial registry is returned.
+    """
+
+    requested = tuple(selections)
+    if not requested:
+        raise ElementRegistryError(f"selected pack {pack.id!r} has no definitions")
+    if len(set(requested)) != len(requested):
+        raise ElementRegistryError(f"selected pack {pack.id!r} contains duplicate definitions")
+
+    registry = element_kind_registry or _element_kind_registry_for_packs((pack,))
+    roots: dict[tuple[str, str], Path] = {}
+    for kind, root in iter_element_roots(pack, element_kind_registry=registry):
+        key = (kind, root.name)
+        if key in roots:
+            raise ElementRegistryError(
+                f"selected pack {pack.id!r} exposes duplicate definition {key!r}"
+            )
+        roots[key] = root
+
+    definitions: list[ElementDefinition] = []
+    for raw_kind, element_id in requested:
+        kind = registry.normalize(raw_kind, error_cls=ElementRegistryError)
+        key = (kind, element_id)
+        root = roots.get(key)
+        if root is None:
+            raise ElementRegistryError(
+                f"selected pack {pack.id!r} is missing definition {key!r}"
+            )
+        definition = load_element_definition(
+            root,
+            kind=kind,
+            source=f"pack:{pack.id}",
+            editable=pack.id == "local",
+            priority=30,
+            element_kind_registry=registry,
+        )
+        validate_element_pack_id(
+            definition.metadata.get("pack_id"), pack, element_root=root
+        )
+        definitions.append(definition)
+
+    actual = tuple((definition.kind, definition.id) for definition in definitions)
+    expected = tuple((registry.normalize(kind), element_id) for kind, element_id in requested)
+    if actual != expected:
+        raise ElementRegistryError(
+            f"selected pack {pack.id!r} returned unexpected definitions: {actual!r}"
+        )
+    return tuple(definitions)
+
