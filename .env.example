# Copy to .env.local and fill in. Only VITE_-prefixed vars reach the browser.

# Supabase project URL. `supabase start` prints it (local default below).
VITE_SUPABASE_URL=http://127.0.0.1:54321

# Supabase anon/publishable key. `supabase start` prints it as "anon key".
VITE_SUPABASE_ANON_KEY=

# Marks the runtime as local dev (enables dev-only debug surfaces).
VITE_APP_ENV=dev

# Optional — Vite dev-server port. Default 2222 (config/vite/policy.ts).
# PORT=2222

# Optional — Astrid bridge port the /api/astrid dev proxy targets. Default 17333.
# Used by dev Local mode and `npm run dev:editor` / `npm run dev:editor:bridge`.
# VITE_ASTRID_BRIDGE_PORT=17333

# Optional — neutral Runtime endpoint for the explicit R1 browser path.
# The Vite proxy injects the owner bearer credential server-side when the
# non-VITE token-file variable points at the Runtime's 0600 credential file.
# VITE_WORKSPACE_RUNTIME_URL=http://127.0.0.1:17444
# WORKSPACE_RUNTIME_TOKEN_FILE=/absolute/path/to/owner.token

# Optional — absolute clean canonical Astrid checkout for the local sequence
# modules. No sibling checkout is inferred; the Vite/Vitest aliases resolve
# `@astrid/*` to its `astrid/` source directory.
# ASTRID_CHECKOUT=/absolute/path/to/clean/Astrid

# Optional — prepared Python entrypoint used by the server-side creative
# generation composer. Keep this pointed at the prepared virtualenv's
# executable so its Astrid/runtime dependencies remain available; it must be
# an absolute path. The composer invokes the fixed
# `astrid.sdk.generation_publication` module from ASTRID_CHECKOUT with a
# bounded JSON stdin/stdout envelope.
# ASTRID_PYTHON=/absolute/path/to/prepared/venv/bin/python

# Optional — enable the same-origin hosted relay in the Vite dev/preview host.
# Outside an explicit loopback test this must be an HTTPS origin. The relay
# keeps only volatile pairing state; it never receives the Runtime bearer.
# REIGH_PAIRED_RELAY_ORIGIN=https://reigh.example.test
# REIGH_PAIRED_RELAY_ENABLED=1
# REIGH_PAIRED_RELAY_LOOPBACK_TEST=1
# Start the user-local half with: npm run dev:local -- --paired
# ASTRID_PRODUCT_TOKEN_FILE=/absolute/path/to/product.token
# ASTRID_WORKSPACE_DISCOVERY=/absolute/path/to/runtime/discovery.json
# REIGH_PAIRED_REALM_ID=expected-realm-id
# REIGH_PAIRED_PRODUCT_ACTOR=expected-product-actor
# REIGH_PAIRED_CONNECTOR_STATE=/absolute/path/to/owner-only/paired-connector.json
# ASTRID_LOCAL_COMPOSE_URL=http://127.0.0.1:2222/api/astrid/generation/compose
